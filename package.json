{
  "name": "eagle-plugin-map",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "tsc --noEmit",
    "build": "tsc -b && vite build",
    "lint": "eslint --fix .",
